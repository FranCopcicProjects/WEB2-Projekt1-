<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Digitalne propusnice</title>
        <link rel="stylesheet" href="/style.css">
    </head>

    <body>
        <div class="main-div">
            <h1>Digitalne Propusnice</h1>

            <p>Ukupan broj propusnica: <%= totalPasses %></p>
            <p>Broj aktivnih propusnica: <%= activePasses %></p>

            <% if (isAuthenticated) { %>

                <p>Dobrodošao, <%= username %>!</p>

                <a href="/manage">Upravljanje propusnicama</a>

                <form action="/logout" method="POST">
                    <button type="submit">Odjava</button>
                </form>

            <% } else { %>

                <a href="/login">Prijava</a>

            <% } %>
            
        </div>
    </body>
</html>