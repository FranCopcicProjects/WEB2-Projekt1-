<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Upravljanje propusnicama</title>
        <link rel="stylesheet" href="/style.css">
    </head>

    <body>
        <div class="manage-div">

            <h1>Upravljanje propusnicama</h1>

            <table>
                <thead>
                    <tr>
                        <th>Ime i prezime</th>
                        <th>Dokument</th>
                        <th>Vrijeme izdavanja</th>
                        <th>Status</th>
                        <th>Akcije</th>
                    </tr>
                </thead>

                <tbody>
                    <% passes.forEach(pass => { %>
                        <tr>
                            <td>
                                <a href="/pass/<%= pass.id %>">
                                    <%= pass.name %>
                                </a>
                            </td>
                            <td><%= pass.document %></td>
                            <td><%= new Date(pass.issued_at).toLocaleString("hr-HR") %></td>
                            <% if (pass.status === "CANCELLED") { %>
                                <td class="cancelled"><%= pass.status %></td>
                            <% } else { %>
                                <td><%= pass.status %></td>
                            <% } %>
                             

                            <td>
                                <% if (pass.status === "ACTIVE") { %>
                                    <form action="/passes/<%= pass.id %>/cancel" method="POST">
                                        <button type="submit">Poništi</button>
                                    </form>
                                <% } %>

                                <form action="/passes/<%= pass.id %>/delete" method="POST">
                                    <button type="submit">Obriši</button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>

            <a href="/">Povratak na početnu</a>

        </div>
    </body>
</html>